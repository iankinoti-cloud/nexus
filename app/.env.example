# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Supabase (optional — enables Google login + cloud workspace sync;
# leave empty to run in guest/local mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional overrides
# NEXUS_MODEL=claude-opus-4-8
# PORT=8787
# NEXUS_ALLOWED_ORIGINS=https://yourdomain.com

# Required if using an identity-linked API key (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
